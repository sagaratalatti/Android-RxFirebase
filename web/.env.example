# OpenAI — for server proxy mode (Vercel/Netlify/local dev)
OPENAI_API_KEY=sk-your-key-here

# Supabase — optional, for accounts, cloud sync, and share links
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# After setting Supabase vars, run supabase/schema.sql in your Supabase SQL editor
