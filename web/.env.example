# OpenAI — server proxy mode
OPENAI_API_KEY=sk-your-key-here

# OpenRouter — alternative server proxy (set AI_PROVIDER=openrouter or omit OPENAI_API_KEY)
OPENROUTER_API_KEY=sk-or-your-key-here
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
APP_URL=http://localhost:5173

# Supabase — accounts, cloud sync, teams, sharing
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — billing (server-side)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TEAM_PRICE_ID=price_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_TEAM_PRICE_ID=price_...

# Admin dashboard (comma-separated emails)
VITE_ADMIN_EMAILS=you@yourstartup.com
ADMIN_EMAILS=you@yourstartup.com

# Run supabase/schema.sql, schema-v2.sql, schema-v3.sql in Supabase SQL Editor
